  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shreyassaw5394/clip-anything.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/shreyassaw5394/clip-anything#readme",
  "bugs": "https://github.com/shreyassaw5394/clip-anything/issues",
  "scripts": {
